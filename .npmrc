# Vercel runs a clean `npm install`. If a transitive peer-dependency ever
# disagrees (the eslint-config-next@16 vs eslint@8 case that broke the build),
# resolve it instead of aborting the whole deployment.
#
# `overrides` in package.json is the real fix; this is the seatbelt.
legacy-peer-deps=true
audit=false
fund=false
