{
  "name": "aquanexa",
  "version": "1.0.0",
  "private": true,
  "description": "AquaNexa (rokadoctor.in) — Pan-India RO e-commerce + Patna local service booking platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push && npm run db:search",
    "db:migrate": "prisma migrate dev && npm run db:search",
    "db:search": "psql $DATABASE_URL -f prisma/migrations/00_search_extensions/migration.sql",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:push && npm run db:seed",
    "db:studio": "prisma studio",
    "db:raw": "psql $DATABASE_URL -f db/schema.sql",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@prisma/client": "^5.18.0",
    "next-auth": "^4.24.7",
    "@auth/prisma-adapter": "^2.4.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.4",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-table": "^8.20.1",
    "razorpay": "^2.9.4",
    "ioredis": "^5.4.1",
    "recharts": "^2.12.7",
    "lucide-react": "^0.427.0",
    "react-hook-form": "^7.52.2",
    "@hookform/resolvers": "^3.9.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.2",
    "class-variance-authority": "^0.7.0",
    "sharp": "^0.33.4",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
    "sonner": "^1.5.0",
    "embla-carousel-react": "^8.1.8",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-accordion": "^1.2.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^22.1.0",
    "@types/react": "^18.3.3",
    "@types/bcryptjs": "^2.4.6",
    "tailwindcss": "^3.4.9",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.14",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "prisma": "^5.18.0",
    "tsx": "^4.16.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "vitest": "^2.0.5",
    "@playwright/test": "^1.46.0"
  },
  "engines": { "node": ">=20" }
}
