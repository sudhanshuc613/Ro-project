# ─── Core ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rokadoctor.in
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aquanexa:password@localhost:5432/aquanexa?schema=public
DIRECT_URL=postgresql://aquanexa:password@localhost:5432/aquanexa?schema=public

# ─── Cache / Queue ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with__openssl_rand_base64_32
JWT_SECRET=another_long_random_string

# ─── Payments: Razorpay ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxxxx
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=aquanexa_verify_token
# REQUIRED for the free WhatsApp reverse-OTP flow. Meta app -> Settings ->
# Basic -> App Secret. Without it the inbound webhook rejects everything,
# deliberately: an unsigned webhook would let anyone verify any number.
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_WHATSAPP_NUMBERS=918969821440,919661288308

# ─── Media storage ───────────────────────────────────────────────────────────
# OPTIONAL. Admin image upload works WITHOUT any of these — images are stored
# in Postgres and served by /api/media/[id].
#
# Add BLOB_READ_WRITE_TOKEN only when you want images on a real CDN:
#   Vercel dashboard → Storage → Create → Blob → Connect to project
# Vercel injects this automatically once connected. New uploads then go to the
# CDN; existing ones keep working from the database, nothing breaks.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Legacy alternatives (not wired up — Blob or database is the supported path)
# CLOUDINARY_CLOUD_NAME=aquanexa
# CLOUDINARY_API_KEY=xxxxxxxxxxxx
# CLOUDINARY_API_SECRET=xxxxxxxxxxxx

# ─── Shipping ────────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=ops@rokadoctor.in
SHIPROCKET_PASSWORD=xxxxxxxx

# ─── SMS / OTP ───────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=xxxxxxxxxxxx
MSG91_TEMPLATE_ID=xxxxxxxxxxxx

# ─── Analytics & SEO ─────────────────────────────────────────────────────────
# GA ID ab src/lib/constants.ts (ANALYTICS.gaId) mein hai — G-JP9HDZ9SE3
# Ye sirf tab set karo jab alag property use karni ho (jaise staging)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxx
NEXT_PUBLIC_FB_PIXEL_ID=xxxxxxxxxxxx

# ─── Cron protection ─────────────────────────────────────────────────────────
CRON_SECRET=long_random_string_for_vercel_cron_auth
