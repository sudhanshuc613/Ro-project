# ─── Core ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://rokadoctor.in
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aquanexa:password@localhost:5432/aquanexa?schema=public
DIRECT_URL=postgresql://aquanexa:password@localhost:5432/aquanexa?schema=public

# ─── Cache / Queue ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with__openssl_rand_base64_32
JWT_SECRET=another_long_random_string

# ─── Payments: Razorpay ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=xxxxxxxxxxxxxxx
WHATSAPP_BUSINESS_ACCOUNT_ID=xxxxxxxxxxxxxxx
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxx
WHATSAPP_VERIFY_TOKEN=aquanexa_verify_token
ADMIN_WHATSAPP_NUMBERS=918969821440,919661288308

# ─── Media storage (Cloudinary or S3) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=aquanexa
CLOUDINARY_API_KEY=xxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxx
# AWS_S3_BUCKET=aquanexa-media
# AWS_REGION=ap-south-1

# ─── Shipping ────────────────────────────────────────────────────────────────
SHIPROCKET_EMAIL=ops@rokadoctor.in
SHIPROCKET_PASSWORD=xxxxxxxx

# ─── SMS / OTP ───────────────────────────────────────────────────────────────
MSG91_AUTH_KEY=xxxxxxxxxxxx
MSG91_TEMPLATE_ID=xxxxxxxxxxxx

# ─── Analytics & SEO ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxx
NEXT_PUBLIC_FB_PIXEL_ID=xxxxxxxxxxxx

# ─── Cron protection ─────────────────────────────────────────────────────────
CRON_SECRET=long_random_string_for_vercel_cron_auth
